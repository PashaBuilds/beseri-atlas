  "sinir": [
    {
      "id": "olay-malazgirt",
      "sinir": "Malazgirt hakkında çağdaş Bizans anlatıları ile daha geç İslam tarihleri aynı ayrıntıları ve sayıları vermez; açık erişimde güvenle satır satır doğrulanabilen Türkçe bir çağdaş metin bu dosyanın kaynak setinde yoktur. Bu nedenle asker sayıları ve konuşmalar ikincil sentezden aktarılır, kesin tanıklık gibi sunulmaz."
    },
    {
      "id": "olay-talas-savasi",
      "sinir": "Talas Savaşı hakkında ayrıntılı anlatılar olaydan sonra derlenen Arapça ve Çince tarihlere dayanır; açık erişimde satır satır doğrulanmış çağdaş bir savaş tutanağı bu dosyanın kaynak setinde yoktur. Karlukların rolü, savaşın ölçeği ve kâğıt aktarımı bu yüzden kesin tanıklık değil kaynaklar arası yorum olarak okunmalıdır."
    }
  ],
