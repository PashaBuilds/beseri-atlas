{
  "name": "beseri-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Turkce, kaynak-zorunlu, statik beseri bilimler bilgi atlasi",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node araclar/kapilar.mjs --pre && astro build && pagefind --site dist && node araclar/kapilar.mjs --post",
    "preview": "astro preview",
    "otonom": "node otonom/orkestrator.mjs",
    "durum": "node araclar/durum.mjs",
    "lint": "node araclar/kapilar.mjs --lint",
    "denetle": "node araclar/denetle.mjs",
    "curut": "node araclar/curut.mjs",
    "turet": "node araclar/turet.mjs",
    "uretim": "node araclar/uretim-hatti.mjs",
    "capraz": "node araclar/capraz-kontrol.mjs",
    "ornekle": "node araclar/ornekle.mjs",
    "rapor": "node araclar/rapor.mjs",
    "canlilik": "node araclar/kaynak-canlilik.mjs",
    "arama": "pagefind --site dist",
    "test": "for f in testler/*.test.mjs; do node \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "astro": "^5.14.1",
    "remark-directive": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@types/node": "^26.4.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  }
}
