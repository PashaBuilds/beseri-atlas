---
/**
 * Bir dönemin makaleleri, okunacak sırayla. Dönem sayfasının sonunda durur.
 *
 * Bu liste var olmadan önce dönem sayfası yalnızca elle yazılmış `ilgili`
 * kutusunu gösteriyordu: Dönem 14 için 31 makalenin 10'u. Kalan 21'ine ancak
 * arama ya da dizin üzerinden, tesadüfen ulaşılabiliyordu.
 */
import { yol, tipAdi } from '../lib/icerik';

export interface Props {
  hat: any[];        // dönemin makaleleri, giriş hariç, sıralı
  donemNo: string;
}
const { hat, donemNo } = Astro.props;

/** "1947-08-15" → "1947" · "-0334" → "MÖ 334" — listede yıl yeter. */
function yil(t: unknown) {
  const m = /^(-?)(\d+)/.exec(String(t ?? '').trim());
  if (!m) return '';
  return m[1] === '-' ? `MÖ ${Number(m[2])}` : String(Number(m[2]));
}

/**
 * Aralık etiketi. Yalnızca başlangıç yılını göstermek yanıltıcı olabiliyordu:
 * "Çin Devrimi (1949)" makalesinin yanında `tarih_baslangic` gereği "1927"
 * yazıyor ve başlıkla çelişiyor gibi duruyordu. Aralık ikisini de doğru anlatır.
 */
function yilEtiketi(bas: unknown, bit: unknown) {
  const a = yil(bas); const b = yil(bit);
  return !b || a === b ? a : `${a}–${b}`;
}
---
<section class="hat" aria-labelledby="hat-baslik" data-pagefind-ignore>
  <h2 id="hat-baslik" class="hat__baslik">Bu dönemi sırayla okuyun</h2>
  <p class="hat__aciklama">
    Dönem {donemNo}'e ait {hat.length} makale, olayların kendi sırasında.
    Her makalenin altındaki şeritten durmadan devam edebilirsiniz.
  </p>
  <ol class="hat__liste">
    {hat.map((e: any, i: number) => (
      <li class="hat__oge">
        <a class="hat__bag" href={yol(e.data.id)}>
          <span class="hat__no">{String(i + 1).padStart(2, '0')}</span>
          <span class="hat__ic">
            <span class="hat__ust">
              <span class="hat__tip">{tipAdi(e.data.tip)}</span>
              <span class="hat__yil">{yilEtiketi(e.data.tarih_baslangic, e.data.tarih_bitis)}</span>
            </span>
            <span class="hat__ad">{e.data.baslik}</span>
            <span class="hat__ozet">{e.data.ozet}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .hat { margin: 3rem 0; padding-top: 1.5rem; border-top: 1px solid var(--cizgi); }
  .hat__baslik {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 32, 'SOFT' 0, 'WONK' 0;
    font-size: 1.35rem; margin: 0 0 0.5rem;
  }
  .hat__aciklama { font-size: 0.92rem; color: var(--golge); margin: 0 0 1.4rem; line-height: 1.6; }

  .hat__liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--cizgi-ince); }
  .hat__oge { border-bottom: 1px solid var(--cizgi-ince); }

  .hat__bag {
    display: grid; grid-template-columns: 2.75rem 1fr; gap: 0 0.9rem;
    padding: 0.85rem 0.6rem; text-decoration: none; color: inherit;
    transition: background var(--gecis);
  }
  .hat__bag:hover { background: var(--yuzey); }

  .hat__no {
    font-family: var(--f-veri); font-size: 0.78rem; font-weight: 600;
    color: var(--bakir); padding-top: 0.15rem; font-variant-numeric: tabular-nums;
  }
  .hat__ic { display: block; min-width: 0; }
  .hat__ust { display: flex; gap: 0.6rem; align-items: baseline; margin-bottom: 0.15rem; }
  .hat__tip {
    font-family: var(--f-veri); font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--golge);
  }
  .hat__yil {
    font-family: var(--f-veri); font-size: 0.68rem; color: var(--golge);
    font-variant-numeric: tabular-nums;
  }
  .hat__ad {
    display: block; font-family: var(--f-display);
    font-variation-settings: 'opsz' 20, 'SOFT' 0, 'WONK' 0;
    font-weight: 600; font-size: 1rem; line-height: 1.3; margin-bottom: 0.2rem;
  }
  .hat__bag:hover .hat__ad { color: var(--bakir); }
  .hat__ozet { display: block; font-size: 0.86rem; line-height: 1.5; color: var(--golge); }

  @media (max-width: 560px) {
    .hat__bag { grid-template-columns: 2rem 1fr; gap: 0 0.6rem; }
  }
</style>
