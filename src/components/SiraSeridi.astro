---
/**
 * Makale altındaki ileri/geri şeridi — hattın okurun gördüğü yüzü.
 *
 * Dönemin son makalesinden sonraki adım bir sonraki dönemin giriş makalesidir,
 * yani şerit on altı dönem boyunca kopmaz: Dönem 01'in girişinden başlayıp
 * hiç geri dönmeden Dönem 16'nın sonuna kadar gidilebilir.
 */
import { yol, TIP_ADLARI } from '../lib/icerik';

export interface Props {
  onceki: any | null;
  sonraki: any | null;
  sira: number;    // 0 = dönem girişi
  toplam: number;
  donemNo: string;
}
const { onceki, sonraki, sira, toplam, donemNo } = Astro.props;
const konum = sira === 0 ? `Dönem ${donemNo} · giriş` : `Dönem ${donemNo} · ${sira}/${toplam}`;
---
<nav class="sira" aria-label="Dönem okuma sırası" data-pagefind-ignore>
  {onceki ? (
    <a class="sira__bag sira__bag--geri" href={yol(onceki.data.id)} rel="prev">
      <span class="sira__yon">← Önceki</span>
      <span class="sira__ad">{onceki.data.baslik}</span>
      <span class="sira__tip">{TIP_ADLARI[onceki.data.tip]}</span>
    </a>
  ) : <span class="sira__bos" />}

  <span class="sira__konum">{konum}</span>

  {sonraki ? (
    <a class="sira__bag sira__bag--ileri" href={yol(sonraki.data.id)} rel="next">
      <span class="sira__yon">Sonraki →</span>
      <span class="sira__ad">{sonraki.data.baslik}</span>
      <span class="sira__tip">{TIP_ADLARI[sonraki.data.tip]}</span>
    </a>
  ) : <span class="sira__bos" />}
</nav>

<style>
  .sira {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem;
    align-items: start;
    margin: 2.5rem 0 0; padding-top: 1.4rem;
    border-top: 1px solid var(--cizgi);
  }

  .sira__bag {
    display: block; text-decoration: none; color: inherit;
    padding: 0.7rem 0.85rem; border: 1px solid var(--cizgi-ince);
    border-radius: var(--yuvarlak-buyuk); background: var(--yuzey);
    transition: background var(--gecis), border-color var(--gecis);
    min-width: 0;
  }
  .sira__bag:hover { background: var(--yuzey-2); border-color: var(--cizgi); }
  .sira__bag--ileri { text-align: end; grid-column: 3; }

  .sira__yon {
    display: block; font-family: var(--f-veri); font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--bakir);
    margin-bottom: 0.3rem;
  }
  .sira__ad {
    display: block; font-family: var(--f-display);
    font-variation-settings: 'opsz' 18, 'SOFT' 0, 'WONK' 0;
    font-weight: 600; font-size: 0.98rem; line-height: 1.3;
  }
  .sira__tip {
    display: block; font-family: var(--f-veri); font-size: 0.62rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--golge);
    margin-top: 0.25rem;
  }

  .sira__konum {
    font-family: var(--f-veri); font-size: 0.68rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--golge);
    white-space: nowrap; padding-top: 0.8rem;
  }
  .sira__bos { display: block; }

  @media (max-width: 640px) {
    .sira { grid-template-columns: 1fr; gap: 0.6rem; }
    .sira__bag--ileri { text-align: start; grid-column: 1; }
    .sira__konum { padding-top: 0.2rem; text-align: center; }
    .sira__bos { display: none; }
  }
</style>
