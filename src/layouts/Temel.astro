---
import '../styles/temel.css';
import { bag } from '../lib/icerik';
import { MARKA } from '../lib/marka';
export interface Props { baslik: string; ozet?: string; sayfaTuru?: 'website' | 'article'; }
const {
  baslik,
  ozet = MARKA.aciklama,
  sayfaTuru = 'website',
} = Astro.props;
const yol = Astro.url.pathname;
const menu = [
  { ad: 'Bugün', h: bag('/bugun/') },
  { ad: 'Rotalar', h: bag('/rotalar/') },
  { ad: 'Zaman', h: bag('/zaman-seridi/') },
  { ad: 'Ara', h: bag('/ara/') },
  { ad: 'Defterim', h: bag('/defter/') },
];
const tamBaslik = baslik === 'Ana sayfa' ? MARKA.ad : `${baslik} — ${MARKA.ad}`;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={ozet} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content={sayfaTuru} />
    <meta property="og:site_name" content={MARKA.ad} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={ozet} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={bag("/favicon.svg")} type="image/svg+xml" />
    {/* Tema ve okuma seçimi boyanmadan önce uygulanmalı — aksi hâlde yanıp söner. */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('dunya-orgusu-tema') || localStorage.getItem('baglam-tema') || localStorage.getItem('beseri-tema');
          if (t) document.documentElement.dataset.tema = t;
          var y = localStorage.getItem('dunya-orgusu-yazi-v1') || localStorage.getItem('baglam-yazi-v1');
          if (y === 'kitap' || y === 'ayirt') document.documentElement.dataset.yazi = y;
          var b = localStorage.getItem('dunya-orgusu-yazi-boyutu-v1') || localStorage.getItem('baglam-yazi-boyutu-v1');
          if (b === 'standart' || b === 'buyuk') document.documentElement.dataset.yaziBoyutu = b;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="atla" href="#ana">İçeriğe atla</a>
    <header class="ust">
      <div class="ust__ic">
        <a class="marka" href={bag("/")} aria-label={`${MARKA.ad} ana sayfa`}>
          <span class="marka__isaret" aria-hidden="true">{MARKA.isaret}</span>
          <span class="marka__ad">{MARKA.ad}</span>
          <span class="marka__vaat">{MARKA.vaat}</span>
        </a>
        <nav aria-label="Ana gezinme">
          {menu.map((m) => (
            <a href={m.h} aria-current={yol === m.h ? 'page' : undefined}>{m.ad}</a>
          ))}
        </nav>
        <div class="ust__araclar">
          <details class="okuma-ayari" data-okuma-ayari>
            <summary aria-label="Okuma görünümünü ayarla">Okuma</summary>
            <div class="okuma-ayari__panel">
              <fieldset>
                <legend>Yazı karakteri</legend>
                <label>
                  <input type="radio" name="okuma-yazisi" value="kitap" data-yazi-sec />
                  <span><strong>Kitap ritmi</strong><small>Literata · uzun metin için</small></span>
                </label>
                <label>
                  <input type="radio" name="okuma-yazisi" value="ayirt" data-yazi-sec />
                  <span><strong>Ayırt etmesi kolay</strong><small>Atkinson · belirgin harfler</small></span>
                </label>
              </fieldset>
              <fieldset>
                <legend>Metin boyutu</legend>
                <div class="okuma-ayari__boyut">
                  <label><input type="radio" name="okuma-boyutu" value="standart" data-boyut-sec /> Standart</label>
                  <label><input type="radio" name="okuma-boyutu" value="buyuk" data-boyut-sec /> Büyük</label>
                </div>
              </fieldset>
              <p>Seçimin yalnızca bu cihazda saklanır.</p>
            </div>
          </details>
          <button class="tema-dugme" type="button" data-tema-degistir aria-live="polite">Tema</button>
        </div>
      </div>
    </header>
    <div class="kabuk">
      <slot />
    </div>
    <footer class="alt">
      <div class="alt__ic">
        <div>
          <a class="alt__marka" href={bag('/')}>{MARKA.ad}</a>
          <p>{MARKA.aciklama}</p>
        </div>
        <nav aria-label="Alt gezinme">
          <a href={bag('/dizin/')}>Tüm içerik</a>
          <a href={bag('/donem/')}>16 dönem</a>
          <a href={bag('/hakkinda/')}>Yöntem ve güven</a>
        </nav>
        <p class="alt__not">{MARKA.eskiAd} korpusundan doğdu. Kaynaklar açık, belirsizlikler görünür.</p>
      </div>
    </footer>
    <script is:inline>
      document.querySelectorAll('[data-tema-degistir]').forEach(function (d) {
        // Ilk erisilebilir ad: dugme daha tiklanmadan ne yapacagini soylesin.
        var ilk = document.documentElement.dataset.tema
          || (matchMedia('(prefers-color-scheme: dark)').matches ? 'koyu' : 'acik');
        d.setAttribute('aria-label', ilk === 'koyu' ? 'Açık temaya geç' : 'Koyu temaya geç');
        d.addEventListener('click', function () {
          var k = document.documentElement;
          var suan = k.dataset.tema
            || (matchMedia('(prefers-color-scheme: dark)').matches ? 'koyu' : 'acik');
          var yeni = suan === 'koyu' ? 'acik' : 'koyu';
          k.dataset.tema = yeni;
          try { localStorage.setItem('dunya-orgusu-tema', yeni); } catch (e) {}
          d.setAttribute('aria-label', yeni === 'koyu' ? 'Açık temaya geç' : 'Koyu temaya geç');
        });
      });

      var kok = document.documentElement;
      var yazi = kok.dataset.yazi === 'ayirt' ? 'ayirt' : 'kitap';
      var boyut = kok.dataset.yaziBoyutu === 'buyuk' ? 'buyuk' : 'standart';
      kok.dataset.yazi = yazi;
      kok.dataset.yaziBoyutu = boyut;

      document.querySelectorAll('[data-yazi-sec]').forEach(function (secim) {
        secim.checked = secim.value === yazi;
        secim.addEventListener('change', function () {
          if (!secim.checked) return;
          kok.dataset.yazi = secim.value;
          try { localStorage.setItem('dunya-orgusu-yazi-v1', secim.value); } catch (e) {}
        });
      });
      document.querySelectorAll('[data-boyut-sec]').forEach(function (secim) {
        secim.checked = secim.value === boyut;
        secim.addEventListener('change', function () {
          if (!secim.checked) return;
          kok.dataset.yaziBoyutu = secim.value;
          try { localStorage.setItem('dunya-orgusu-yazi-boyutu-v1', secim.value); } catch (e) {}
        });
      });

      document.querySelectorAll('[data-okuma-ayari]').forEach(function (panel) {
        panel.addEventListener('keydown', function (olay) {
          if (olay.key === 'Escape') {
            panel.removeAttribute('open');
            panel.querySelector('summary')?.focus();
          }
        });
      });
    </script>
  </body>
</html>
