---
import { bag } from '../lib/icerik';
import Temel from '../layouts/Temel.astro';
---
<Temel baslik="Sayfa bulunamadı">
  <main id="ana" style="max-width:44rem;margin:0 auto;padding:5rem 2rem">
    <p class="veri-etiket">404</p>
    <h1>Bu sayfa yok</h1>
    <p style="color:var(--golge)">
      Aradığınız içerik yayımlanmamış olabilir: denetimden geçmeyen makaleler
      karantinada tutulur ve production build'e girmez.
    </p>
    <p><a href={bag("/")}>Ana sayfaya dön</a> · <a href={bag("/dizin/")}>Dizine bak</a></p>
  </main>
</Temel>
