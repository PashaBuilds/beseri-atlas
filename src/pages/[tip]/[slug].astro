---
import fs from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import AygitRayi from '../../components/AygitRayi.astro';
import KaynakListesi from '../../components/KaynakListesi.astro';
import ZamanSeridi from '../../components/ZamanSeridi.astro';
import Pozisyonlar from '../../components/Pozisyonlar.astro';
import VeriGrafigi from '../../components/VeriGrafigi.astro';
import OkumaHatti from '../../components/OkumaHatti.astro';
import SiraSeridi from '../../components/SiraSeridi.astro';
import { tumOnayliIcerik, baglariCoz, okumaHatti, komsular, TIP_ADLARI, GUVEN_ADLARI, bag, tipAdi } from '../../lib/icerik';

export async function getStaticPaths() {
  const korpus = await tumOnayliIcerik();
  const donemler = korpus
    .filter((e: any) => e.data.tip === 'donem')
    .sort((a: any, b: any) => a.data.donem.localeCompare(b.data.donem))
    .map((e: any) => ({
      id: e.data.id, no: e.data.donem, baslik: e.data.baslik,
      aralik: e.data.eksen_cumlesi ? `${e.data.tarih_baslangic ?? ''}–${e.data.tarih_bitis ?? ''}` : '',
      serit: e.data.serit ?? [],
    }));

  return korpus.map((girdi: any) => {
    const [tip, ...rest] = girdi.data.id.split('-');
    return {
      params: { tip, slug: rest.join('-') },
      props: { girdi, korpus, donemler },
    };
  });
}

const { girdi, korpus, donemler } = Astro.props;
const v = girdi.data;
const { Content, headings } = await render(girdi);

// Hakem katmani: makale kor bir hakemden gectiyse iddia-kaynak matrisi vardir.
// Bunu okura soylemek zorunludur — "denetlendi" ifadesi tek basina, mekanik
// katmanin gordugu kadariyla denetlenmis bir dosyayla hakemden gecmis bir
// dosyayi ayni gosterir. Matris yoksa beyan bunu da acikca soyler.
let hakem: { dogrudan: number; kismi: number; iddia: number; zaman: string } | null = null;
try {
  const matrisYolu = path.join(process.cwd(), 'denetim', 'matris', `${v.id}-matris.json`);
  if (fs.existsSync(matrisYolu)) {
    const mat = JSON.parse(fs.readFileSync(matrisYolu, 'utf8'));
    if (String(mat.hakem ?? '').startsWith('kor-hakem')) {
      hakem = {
        dogrudan: mat.sayaclar?.dogrudan ?? 0,
        kismi: mat.sayaclar?.kismi ?? 0,
        iddia: (mat.iddialar ?? []).length,
        zaman: String(mat.zaman ?? '').slice(0, 10),
      };
    }
  }
} catch { /* bozuk matris beyani degistirmez */ }
// İçindekiler: yalnızca h2 başlıklar; kısa makalede gürültü olmasın diye
// 4'ten az bölümde gösterilmez.
const bolumler = (headings ?? []).filter((h: { depth: number }) => h.depth === 2);
const icindekilerGoster = bolumler.length >= 4;
const ilgili = baglariCoz(v.ilgili, korpus);
const okuma = baglariCoz(v.okuma_onerisi, korpus);
// Okuma hatti: donem sayfasi kendi makalelerini sirali listeler, her makale
// de hattaki komsularini gosterir. Donemi olmayan tipler hatta girmez.
const hat = v.tip === 'donem' ? okumaHatti(korpus, String(v.donem)).slice(1) : [];
const komsu = komsular(korpus, girdi);
---
<Temel baslik={v.baslik} ozet={v.ozet}>
  <div class="sayfa">
    <main class="govde" id="ana" data-pagefind-body
          data-pagefind-filter={`tip:${tipAdi(v.tip)}`}
          data-pagefind-meta={`ozet:${v.ozet}`}>
      <p class="veri-etiket" style="margin-bottom:.6rem">
        {tipAdi(v.tip)}
        {v.donem && <> · Dönem {v.donem}</>}
      </p>
      <h1>{v.baslik}</h1>
      <p class="ozet">{v.ozet}</p>

      {icindekilerGoster && (
        <nav class="icindekiler" aria-label="Bölümler">
          <details>
            <summary>İçindekiler ({bolumler.length} bölüm)</summary>
            <ol>
              {bolumler.map((h: { slug: string; text: string }) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}

      {v.tip === 'kaynak' && (
        <dl class="kunye">
          <div><dt>Yazar</dt><dd>{v.yazar}</dd></div>
          <div><dt>Eser</dt><dd>{v.eser_adi}</dd></div>
          <div><dt>Yayın</dt><dd>{v.yayin_yili}</dd></div>
          <div>
            <dt>Telif</dt>
            <dd>{v.telif_durumu === 'kamu-mali' ? 'Kamu malı' : 'Telifli — tam metin veya bölüm çevirisi üretilmez'}</dd>
          </div>
        </dl>
      )}

      {v.tip === 'kaynak' && (
        <blockquote class="tez">
          <span class="veri-etiket" style="display:block;margin-bottom:.35rem">Tezi</span>
          {v.tez_ozeti}
        </blockquote>
      )}

      {v.tip === 'tartisma' && (
        <div class="soru-blok">
          <span class="veri-etiket">Soru</span>
          <p class="soru">{v.soru}</p>
          <span class="veri-etiket">Neden önemli</span>
          <p class="neden">{v.neden_onemli}</p>
        </div>
      )}

      {v.tip === 'veri' && <VeriGrafigi veri={v} />}

      <Content />

      {v.tip === 'tartisma' && <Pozisyonlar pozisyonlar={v.pozisyonlar} />}

      {v.tip === 'donem' && hat.length > 0 && <OkumaHatti hat={hat} donemNo={String(v.donem)} />}

      {v.tip === 'donem' && donemler.length > 0 && (
        <ZamanSeridi donemler={donemler} aktif={v.id} baslik="Bu dönemde, yedi bölgede" />
      )}

      <KaynakListesi kaynaklar={v.kaynaklar} />

      <p class="beyan" data-pagefind-ignore>
        Bu makale otonom olarak üretildi ve otonom olarak denetlendi
        (son denetim: {v.son_denetim}, {v.kaynaklar.length} kaynak,
        güven seviyesi: {GUVEN_ADLARI[v.guven_geneli].toLocaleLowerCase('tr')}).
        {hakem ? (
          <span>
            {' '}Bu dosya ayrıca <strong>kör hakemden geçti</strong>: makaleyi yazmamış
            bir oturum {hakem.iddia} iddianın kaynağını tek tek sınadı ({hakem.zaman}) ve
            {' '}{hakem.dogrudan} tanesini kaynağın doğrudan taşıdığı,
            {' '}{hakem.kismi} tanesini kısmen taşıdığı olarak kaydetti.
          </span>
        ) : (
          <span>
            {' '}Bu dosya <strong>henüz kör hakemden geçmedi</strong>; denetimi mekanik
            katmanın gördüğü kadarıyla sınırlıdır.
          </span>
        )}
        Ölçülen doğrulama oranı ve bilinen sınırlar için <a href={bag("/hakkinda/")}>Hakkında</a>.
      </p>

      {v.kaynak_siniri && (
        <p class="beyan beyan--sinir" data-pagefind-ignore>
          <strong>Bu dosyanın kaynak sınırı.</strong> {v.kaynak_siniri}
        </p>
      )}

      {komsu && (
        <SiraSeridi onceki={komsu.onceki} sonraki={komsu.sonraki}
                    sira={komsu.sira} toplam={komsu.toplam} donemNo={komsu.donemNo} />
      )}
    </main>
    <AygitRayi veri={v} ilgili={ilgili} okuma={okuma} />
  </div>
</Temel>

<style>
  .ozet {
    font-size: 1.16rem; line-height: 1.6; color: var(--golge);
    margin: 0 0 2rem; padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--cizgi-ince);
    text-wrap: pretty;
  }
  .kunye { display: grid; gap: 0; margin: 0 0 1.75rem; border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); overflow: hidden; }
  .kunye > div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: .6rem .9rem; background: var(--yuzey); }
  .kunye > div + div { border-top: 1px solid var(--cizgi-ince); }
  .kunye dt { font-family: var(--f-veri); font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--golge); padding-top: .2rem; }
  .kunye dd { margin: 0; font-size: .95rem; }
  .tez { margin: 0 0 2rem !important; padding: 1rem 1.15rem !important; background: var(--yuzey); border-inline-start: 2px solid var(--bakir) !important; border-radius: 0 var(--yuvarlak-buyuk) var(--yuvarlak-buyuk) 0; font-style: normal !important; color: var(--murekkep) !important; }
  .soru-blok { margin: 0 0 2.25rem; padding: 1.15rem 1.25rem; background: var(--yuzey); border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); }
  .soru { font-family: var(--f-display); font-variation-settings: 'opsz' 28, 'SOFT' 0, 'WONK' 0; font-size: 1.24rem; line-height: 1.35; margin: .3rem 0 1.1rem; }
  .neden { margin: .3rem 0 0; font-size: .95rem; color: var(--golge); }
  .beyan--sinir { border-left: 3px solid var(--zincifre); padding-left: .9rem; }
  .beyan { margin-top: 2.5rem; padding-top: 1.1rem; border-top: 1px solid var(--cizgi-ince); font-size: .84rem; line-height: 1.6; color: var(--golge); }
</style>
