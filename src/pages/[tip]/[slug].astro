---
import fs from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import AygitRayi from '../../components/AygitRayi.astro';
import KaynakListesi from '../../components/KaynakListesi.astro';
import ZamanSeridi from '../../components/ZamanSeridi.astro';
import Pozisyonlar from '../../components/Pozisyonlar.astro';
import VeriGrafigi from '../../components/VeriGrafigi.astro';
import OkumaHatti from '../../components/OkumaHatti.astro';
import SiraSeridi from '../../components/SiraSeridi.astro';
import { tumOnayliIcerik, baglariCoz, okumaHatti, komsular, GUVEN_ADLARI, bag, tipAdi } from '../../lib/icerik';
import { makaleRotalari } from '../../lib/rotalar';

export async function getStaticPaths() {
  const korpus = await tumOnayliIcerik();
  const donemler = korpus
    .filter((e: any) => e.data.tip === 'donem')
    .sort((a: any, b: any) => a.data.donem.localeCompare(b.data.donem))
    .map((e: any) => ({
      id: e.data.id, no: e.data.donem, baslik: e.data.baslik,
      aralik: e.data.eksen_cumlesi ? `${e.data.tarih_baslangic ?? ''}–${e.data.tarih_bitis ?? ''}` : '',
      serit: e.data.serit ?? [],
    }));

  return korpus.map((girdi: any) => {
    const [tip, ...rest] = girdi.data.id.split('-');
    return {
      params: { tip, slug: rest.join('-') },
      props: { girdi, korpus, donemler },
    };
  });
}

const { girdi, korpus, donemler } = Astro.props;
const v = girdi.data;
const { Content, headings } = await render(girdi);

// Hakem katmani: makale kor bir hakemden gectiyse iddia-kaynak matrisi vardir.
// Bunu okura soylemek zorunludur — "denetlendi" ifadesi tek basina, mekanik
// katmanin gordugu kadariyla denetlenmis bir dosyayla hakemden gecmis bir
// dosyayi ayni gosterir. Matris yoksa beyan bunu da acikca soyler.
let hakem: { dogrudan: number; kismi: number; iddia: number; zaman: string } | null = null;
try {
  const matrisYolu = path.join(process.cwd(), 'denetim', 'matris', `${v.id}-matris.json`);
  if (fs.existsSync(matrisYolu)) {
    const mat = JSON.parse(fs.readFileSync(matrisYolu, 'utf8'));
    if (String(mat.hakem ?? '').startsWith('kor-hakem')) {
      hakem = {
        dogrudan: mat.sayaclar?.dogrudan ?? 0,
        kismi: mat.sayaclar?.kismi ?? 0,
        iddia: (mat.iddialar ?? []).length,
        zaman: String(mat.zaman ?? '').slice(0, 10),
      };
    }
  }
} catch { /* bozuk matris beyani degistirmez */ }
// İçindekiler: yalnızca h2 başlıklar; kısa makalede gürültü olmasın diye
// 4'ten az bölümde gösterilmez.
const bolumler = (headings ?? []).filter((h: { depth: number }) => h.depth === 2);
const icindekilerGoster = bolumler.length >= 4;
const ilgili = baglariCoz(v.ilgili, korpus);
const okuma = baglariCoz(v.okuma_onerisi, korpus);
// Okuma hatti: donem sayfasi kendi makalelerini sirali listeler, her makale
// de hattaki komsularini gosterir. Donemi olmayan tipler hatta girmez.
const hat = v.tip === 'donem' ? okumaHatti(korpus, String(v.donem)).slice(1) : [];
const komsu = komsular(korpus, girdi);
const rotalar = makaleRotalari(v.id);
const kelimeSayisi = String(girdi.body ?? '')
  .replace(/^---[\s\S]*?---/, '')
  .replace(/\[[^\]]+\]\([^\)]+\)|[`*_#>:{}\[\]]/g, ' ')
  .trim().split(/\s+/).filter(Boolean).length;
const okumaDakikasi = Math.max(2, Math.round(kelimeSayisi / 210));
const DUSUNME_SORULARI: Record<string, string[]> = {
  donem: [
    'Bu dönemi öncekinden ayıran asıl kırılma neydi?',
    'Aynı anda farklı coğrafyalarda hangi süreçler birbirine benziyordu?',
  ],
  olay: [
    'Sonucun ne kadarı uzun dönemli yapılardan, ne kadarı insanların kararlarından doğdu?',
    'Bu olay başka bir coğrafyanın gözünden anlatılsaydı anlatının merkezi ne olurdu?',
  ],
  kavram: [
    'Bu kavram hangi gerçeği görünür kılıyor, hangisini arka planda bırakıyor?',
    'Kavramı bugünkü bir olaya uygularsan açıklayamadığı ne kalır?',
  ],
  dusunur: [
    'Bu düşünür hangi tarihsel soruna cevap vermeye çalışıyordu?',
    'Fikrinin en güçlü itirazı ne olabilir?',
  ],
  tartisma: [
    'Hangi yeni kanıt fikrini değiştirirdi?',
    'Taraflar aynı kelimelere farklı anlamlar yüklüyor olabilir mi?',
  ],
  kurum: [
    'Bu kurum hangi sorunu çözdü, hangi yeni güç ilişkisini yarattı?',
    'Yazılı kurallarla gerçek işleyiş nerede ayrışıyor?',
  ],
  biyografi: [
    'Bu kişinin hareket alanını dönemin hangi koşulları sınırladı?',
    'Aynı koşullarda başka biri benzer bir sonuç üretebilir miydi?',
  ],
  kaynak: [
    'Yazar neyi kanıtlamak istiyor ve hangi kanıt türüne dayanıyor?',
    'Metnin yazıldığı dönemin hangi varsayımları bugün sorgulanabilir?',
  ],
  veri: [
    'Bu ölçüm neyi sayıyor; neyi sayamadığı için görünmez bırakıyor?',
    'Eğilim ile neden-sonuç ilişkisini birbirine karıştırıyor olabilir miyiz?',
  ],
};
const dusunmeSorulari = DUSUNME_SORULARI[v.tip] ?? [
  'Bu anlatının temel nedeni ile görünen sonucu arasındaki bağ ne?',
  'Hangi kanıt veya bakış açısı bu yorumu değiştirebilir?',
];
---
<Temel baslik={v.baslik} ozet={v.ozet} sayfaTuru="article">
  <div class="okuma-ilerleme" aria-hidden="true"><i data-okuma-ilerleme></i></div>
  <div class="sayfa">
    <main class="govde" id="ana" data-pagefind-body
          data-makale-id={v.id}
          data-pagefind-filter={`tip:${tipAdi(v.tip)}`}
          data-pagefind-meta={`ozet:${v.ozet}`}>
      <p class="veri-etiket" style="margin-bottom:.6rem">
        {tipAdi(v.tip)}
        {v.donem && <> · Dönem {v.donem}</>}
      </p>
      <h1>{v.baslik}</h1>
      <p class="ozet">{v.ozet}</p>

      <div class="makale-araclari" data-pagefind-ignore>
        <dl>
          <div><dt>Okuma</dt><dd>≈ {okumaDakikasi} dakika</dd></div>
          <div><dt>Kaynak</dt><dd>{v.kaynaklar.length} künye</dd></div>
          <div><dt>Güven</dt><dd>{GUVEN_ADLARI[v.guven_geneli]}</dd></div>
        </dl>
        <button type="button" data-makale-okundu aria-pressed="false">
          <span data-okundu-etiket>Okundu olarak işaretle</span>
          <b aria-hidden="true">✓</b>
        </button>
      </div>

      {rotalar.length > 0 && (
        <aside class="makale-rotalari" data-pagefind-ignore>
          <span class="veri-etiket">Bu yazı bir düşünme yolunun parçası</span>
          <div>
            {rotalar.map((rota) => (
              <a href={bag(`/rotalar/${rota.slug}/`)}>
                <small>Rota {rota.no}</small>
                <strong>{rota.baslik}</strong>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </aside>
      )}

      <aside class="dusunme-karti" data-pagefind-ignore>
        <span class="veri-etiket">Okurken kendine sor</span>
        <ol>
          {dusunmeSorulari.map((soru) => <li>{soru}</li>)}
        </ol>
      </aside>

      {icindekilerGoster && (
        <nav class="icindekiler" aria-label="Bölümler">
          <details>
            <summary>İçindekiler ({bolumler.length} bölüm)</summary>
            <ol>
              {bolumler.map((h: { slug: string; text: string }) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}

      {v.tip === 'kaynak' && (
        <dl class="kunye">
          <div><dt>Yazar</dt><dd>{v.yazar}</dd></div>
          <div><dt>Eser</dt><dd>{v.eser_adi}</dd></div>
          <div><dt>Yayın</dt><dd>{v.yayin_yili}</dd></div>
          <div>
            <dt>Telif</dt>
            <dd>{v.telif_durumu === 'kamu-mali' ? 'Kamu malı' : 'Telifli — tam metin veya bölüm çevirisi üretilmez'}</dd>
          </div>
        </dl>
      )}

      {v.tip === 'kaynak' && (
        <blockquote class="tez">
          <span class="veri-etiket" style="display:block;margin-bottom:.35rem">Tezi</span>
          {v.tez_ozeti}
        </blockquote>
      )}

      {v.tip === 'tartisma' && (
        <div class="soru-blok">
          <span class="veri-etiket">Soru</span>
          <p class="soru">{v.soru}</p>
          <span class="veri-etiket">Neden önemli</span>
          <p class="neden">{v.neden_onemli}</p>
        </div>
      )}

      {v.tip === 'veri' && <VeriGrafigi veri={v} />}

      <Content />

      {v.tip === 'tartisma' && <Pozisyonlar pozisyonlar={v.pozisyonlar} />}

      {v.tip === 'donem' && hat.length > 0 && <OkumaHatti hat={hat} donemNo={String(v.donem)} />}

      {v.tip === 'donem' && donemler.length > 0 && (
        <ZamanSeridi donemler={donemler} aktif={v.id} baslik="Bu dönemde, yedi bölgede" />
      )}

      <KaynakListesi kaynaklar={v.kaynaklar} />

      <p class="beyan" data-pagefind-ignore>
        Bu makale otonom olarak üretildi ve otonom olarak denetlendi
        (son denetim: {v.son_denetim}, {v.kaynaklar.length} kaynak,
        güven seviyesi: {GUVEN_ADLARI[v.guven_geneli].toLocaleLowerCase('tr')}).
        {hakem ? (
          <span>
            {' '}Bu dosya ayrıca <strong>kör hakemden geçti</strong>: makaleyi yazmamış
            bir oturum {hakem.iddia} iddianın kaynağını tek tek sınadı ({hakem.zaman}) ve
            {' '}{hakem.dogrudan} tanesini kaynağın doğrudan taşıdığı,
            {' '}{hakem.kismi} tanesini kısmen taşıdığı olarak kaydetti.
          </span>
        ) : (
          <span>
            {' '}Bu dosya <strong>henüz kör hakemden geçmedi</strong>; denetimi mekanik
            katmanın gördüğü kadarıyla sınırlıdır.
          </span>
        )}
        Ölçülen doğrulama oranı ve bilinen sınırlar için <a href={bag("/hakkinda/")}>Hakkında</a>.
      </p>

      {v.kaynak_siniri && (
        <p class="beyan beyan--sinir" data-pagefind-ignore>
          <strong>Bu dosyanın kaynak sınırı.</strong> {v.kaynak_siniri}
        </p>
      )}

      {komsu && (
        <SiraSeridi onceki={komsu.onceki} sonraki={komsu.sonraki}
                    sira={komsu.sira} toplam={komsu.toplam} donemNo={komsu.donemNo} />
      )}
    </main>
    <AygitRayi veri={v} ilgili={ilgili} okuma={okuma} />
  </div>
</Temel>

<style>
  .ozet {
    font-size: 1.16rem; line-height: 1.6; color: var(--golge);
    margin: 0 0 2rem; padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--cizgi-ince);
    text-wrap: pretty;
  }
  .okuma-ilerleme { position: fixed; z-index: 40; left: 0; right: 0; top: 0; height: 3px; pointer-events: none; }
  .okuma-ilerleme i { display: block; width: 0; height: 100%; background: var(--bakir); }
  .makale-araclari { display: flex; justify-content: space-between; gap: 1.2rem; align-items: center; margin: -1rem 0 2rem; padding: .8rem 0; border-bottom: 1px solid var(--cizgi-ince); }
  .makale-araclari dl { display: flex; flex-wrap: wrap; gap: 1rem 1.8rem; margin: 0; }
  .makale-araclari dl div { display: grid; }
  .makale-araclari dt { font-family: var(--f-veri); font-size: .58rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--golge); }
  .makale-araclari dd { margin: .12rem 0 0; font-family: var(--f-veri); font-size: .75rem; }
  .makale-araclari button { display: inline-flex; gap: .6rem; align-items: center; flex: 0 0 auto; border: 1px solid var(--cizgi); background: transparent; color: var(--murekkep); padding: .55rem .7rem; font-family: var(--f-veri); font-size: .68rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; cursor: pointer; }
  .makale-araclari button b { display: none; color: var(--bakir); }
  .makale-araclari button[aria-pressed='true'] { border-color: var(--bakir); background: var(--bakir-zemin); }
  .makale-araclari button[aria-pressed='true'] b { display: inline; }
  .makale-rotalari { margin: 0 0 2rem; padding: 1rem 1.1rem; border-left: 2px solid var(--bakir); background: var(--yuzey); }
  .makale-rotalari > div { display: grid; gap: .45rem; margin-top: .65rem; }
  .makale-rotalari a { display: grid; grid-template-columns: 1fr auto; color: inherit; text-decoration: none; padding-top: .5rem; border-top: 1px solid var(--cizgi-ince); }
  .makale-rotalari a small { grid-column: 1; font-family: var(--f-veri); font-size: .6rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--bakir); }
  .makale-rotalari a strong { grid-column: 1; font-family: var(--f-display); }
  .makale-rotalari a > span { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--bakir); }
  .dusunme-karti { margin: 0 0 2rem; padding: 1rem 1.1rem 1.1rem; border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); background: color-mix(in srgb, var(--yuzey) 72%, transparent); }
  .dusunme-karti ol { margin: .7rem 0 0; padding: 0; list-style: none; counter-reset: dusunme; display: grid; gap: .55rem; }
  .dusunme-karti li { counter-increment: dusunme; position: relative; padding-left: 1.8rem; line-height: 1.5; font-family: var(--f-display); font-size: .98rem; }
  .dusunme-karti li::before { content: counter(dusunme, decimal-leading-zero); position: absolute; left: 0; top: .16rem; color: var(--bakir); font-family: var(--f-veri); font-size: .6rem; font-weight: 700; letter-spacing: .06em; }
  .kunye { display: grid; gap: 0; margin: 0 0 1.75rem; border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); overflow: hidden; }
  .kunye > div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: .6rem .9rem; background: var(--yuzey); }
  .kunye > div + div { border-top: 1px solid var(--cizgi-ince); }
  .kunye dt { font-family: var(--f-veri); font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--golge); padding-top: .2rem; }
  .kunye dd { margin: 0; font-size: .95rem; }
  .tez { margin: 0 0 2rem !important; padding: 1rem 1.15rem !important; background: var(--yuzey); border-inline-start: 2px solid var(--bakir) !important; border-radius: 0 var(--yuvarlak-buyuk) var(--yuvarlak-buyuk) 0; font-style: normal !important; color: var(--murekkep) !important; }
  .soru-blok { margin: 0 0 2.25rem; padding: 1.15rem 1.25rem; background: var(--yuzey); border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); }
  .soru { font-family: var(--f-display); font-variation-settings: 'opsz' 28, 'SOFT' 0, 'WONK' 0; font-size: 1.24rem; line-height: 1.35; margin: .3rem 0 1.1rem; }
  .neden { margin: .3rem 0 0; font-size: .95rem; color: var(--golge); }
  .beyan--sinir { border-left: 3px solid var(--zincifre); padding-left: .9rem; }
  .beyan { margin-top: 2.5rem; padding-top: 1.1rem; border-top: 1px solid var(--cizgi-ince); font-size: .84rem; line-height: 1.6; color: var(--golge); }
  @media (max-width: 620px) {
    .makale-araclari { align-items: stretch; flex-direction: column; }
    .makale-araclari button { align-self: flex-start; }
  }
</style>

<script>
  const makale = document.querySelector<HTMLElement>('[data-makale-id]');
  const dugme = document.querySelector<HTMLButtonElement>('[data-makale-okundu]');
  const etiket = document.querySelector<HTMLElement>('[data-okundu-etiket]');
  const anahtar = 'baglam-okunanlar-v1';
  const id = makale?.dataset.makaleId || '';
  let okunanlar: string[] = [];
  try { okunanlar = JSON.parse(localStorage.getItem(anahtar) || '[]'); } catch {}

  function dugmeyiBoya() {
    const ok = okunanlar.includes(id);
    dugme?.setAttribute('aria-pressed', String(ok));
    if (etiket) etiket.textContent = ok ? 'Okundu' : 'Okundu olarak işaretle';
  }

  dugme?.addEventListener('click', () => {
    okunanlar = okunanlar.includes(id) ? okunanlar.filter((x) => x !== id) : [...okunanlar, id];
    try { localStorage.setItem(anahtar, JSON.stringify(okunanlar)); } catch {}
    dugmeyiBoya();
  });
  dugmeyiBoya();

  const cubuk = document.querySelector<HTMLElement>('[data-okuma-ilerleme]');
  function ilerlemeyiBoya() {
    if (!cubuk || !makale) return;
    const bas = makale.getBoundingClientRect().top + scrollY;
    const son = bas + makale.offsetHeight - innerHeight;
    const oran = son <= bas ? 1 : Math.max(0, Math.min(1, (scrollY - bas) / (son - bas)));
    cubuk.style.width = `${oran * 100}%`;
  }
  addEventListener('scroll', ilerlemeyiBoya, { passive: true });
  addEventListener('resize', ilerlemeyiBoya);
  ilerlemeyiBoya();
</script>
