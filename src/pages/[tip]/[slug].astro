---
import fs from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import AygitRayi from '../../components/AygitRayi.astro';
import KaynakListesi from '../../components/KaynakListesi.astro';
import ZamanSeridi from '../../components/ZamanSeridi.astro';
import Pozisyonlar from '../../components/Pozisyonlar.astro';
import VeriGrafigi from '../../components/VeriGrafigi.astro';
import OkumaHatti from '../../components/OkumaHatti.astro';
import SiraSeridi from '../../components/SiraSeridi.astro';
import { tumOnayliIcerik, baglariCoz, okumaHatti, komsular, GUVEN_ADLARI, bag, yol, tipAdi } from '../../lib/icerik';
import { makaleRotalari } from '../../lib/rotalar';

export async function getStaticPaths() {
  const korpus = await tumOnayliIcerik();
  const donemler = korpus
    .filter((e: any) => e.data.tip === 'donem')
    .sort((a: any, b: any) => a.data.donem.localeCompare(b.data.donem))
    .map((e: any) => ({
      id: e.data.id, no: e.data.donem, baslik: e.data.baslik,
      aralik: e.data.eksen_cumlesi ? `${e.data.tarih_baslangic ?? ''}–${e.data.tarih_bitis ?? ''}` : '',
      serit: e.data.serit ?? [],
    }));

  return korpus.map((girdi: any) => {
    const [tip, ...rest] = girdi.data.id.split('-');
    return {
      params: { tip, slug: rest.join('-') },
      props: { girdi, korpus, donemler },
    };
  });
}

const { girdi, korpus, donemler } = Astro.props;
const v = girdi.data;
const { Content, headings } = await render(girdi);

// Hakem katmani: makale kor bir hakemden gectiyse iddia-kaynak matrisi vardir.
// Bunu okura soylemek zorunludur — "denetlendi" ifadesi tek basina, mekanik
// katmanin gordugu kadariyla denetlenmis bir dosyayla hakemden gecmis bir
// dosyayi ayni gosterir. Matris yoksa beyan bunu da acikca soyler.
let hakem: { dogrudan: number; kismi: number; iddia: number; zaman: string } | null = null;
try {
  const matrisYolu = path.join(process.cwd(), 'denetim', 'matris', `${v.id}-matris.json`);
  if (fs.existsSync(matrisYolu)) {
    const mat = JSON.parse(fs.readFileSync(matrisYolu, 'utf8'));
    if (String(mat.hakem ?? '').startsWith('kor-hakem')) {
      hakem = {
        dogrudan: mat.sayaclar?.dogrudan ?? 0,
        kismi: mat.sayaclar?.kismi ?? 0,
        iddia: (mat.iddialar ?? []).length,
        zaman: String(mat.zaman ?? '').slice(0, 10),
      };
    }
  }
} catch { /* bozuk matris beyani degistirmez */ }
// İçindekiler: yalnızca h2 başlıklar; kısa makalede gürültü olmasın diye
// 4'ten az bölümde gösterilmez.
const bolumler = (headings ?? []).filter((h: { depth: number }) => h.depth === 2);
const icindekilerGoster = bolumler.length >= 4;
const ilgili = baglariCoz(v.ilgili, korpus);
const okuma = baglariCoz(v.okuma_onerisi, korpus);
// Okuma hatti: donem sayfasi kendi makalelerini sirali listeler, her makale
// de hattaki komsularini gosterir. Donemi olmayan tipler hatta girmez.
const hat = v.tip === 'donem' ? okumaHatti(korpus, String(v.donem)).slice(1) : [];
const komsu = komsular(korpus, girdi);
const rotalar = makaleRotalari(v.id);
const rotaBaglami = rotalar[0];
const rotaAdimi = rotaBaglami?.adimlar.find((adim) => adim.id === v.id);
const rotaSirasi = rotaBaglami?.adimlar.findIndex((adim) => adim.id === v.id) ?? -1;
const sonrakiRotaAdimi = rotaSirasi >= 0 ? rotaBaglami?.adimlar[rotaSirasi + 1] : undefined;
const sonrakiRotaMakalesi: any = sonrakiRotaAdimi
  ? korpus.find((makale: any) => makale.data.id === sonrakiRotaAdimi.id)
  : null;
const kelimeSayisi = String(girdi.body ?? '')
  .replace(/^---[\s\S]*?---/, '')
  .replace(/\[[^\]]+\]\([^\)]+\)|[`*_#>:{}\[\]]/g, ' ')
  .trim().split(/\s+/).filter(Boolean).length;
const okumaDakikasi = Math.max(2, Math.round(kelimeSayisi / 210));
const DUSUNME_SORULARI: Record<string, string[]> = {
  donem: [
    'Bu dönemi öncekinden ayıran asıl kırılma neydi?',
    'Aynı anda farklı coğrafyalarda hangi süreçler birbirine benziyordu?',
  ],
  olay: [
    'Sonucun ne kadarı uzun dönemli yapılardan, ne kadarı insanların kararlarından doğdu?',
    'Bu olay başka bir coğrafyanın gözünden anlatılsaydı anlatının merkezi ne olurdu?',
  ],
  kavram: [
    'Bu kavram hangi gerçeği görünür kılıyor, hangisini arka planda bırakıyor?',
    'Kavramı bugünkü bir olaya uygularsan açıklayamadığı ne kalır?',
  ],
  dusunur: [
    'Bu düşünür hangi tarihsel soruna cevap vermeye çalışıyordu?',
    'Fikrinin en güçlü itirazı ne olabilir?',
  ],
  tartisma: [
    'Hangi yeni kanıt fikrini değiştirirdi?',
    'Taraflar aynı kelimelere farklı anlamlar yüklüyor olabilir mi?',
  ],
  kurum: [
    'Bu kurum hangi sorunu çözdü, hangi yeni güç ilişkisini yarattı?',
    'Yazılı kurallarla gerçek işleyiş nerede ayrışıyor?',
  ],
  biyografi: [
    'Bu kişinin hareket alanını dönemin hangi koşulları sınırladı?',
    'Aynı koşullarda başka biri benzer bir sonuç üretebilir miydi?',
  ],
  kaynak: [
    'Yazar neyi kanıtlamak istiyor ve hangi kanıt türüne dayanıyor?',
    'Metnin yazıldığı dönemin hangi varsayımları bugün sorgulanabilir?',
  ],
  veri: [
    'Bu ölçüm neyi sayıyor; neyi sayamadığı için görünmez bırakıyor?',
    'Eğilim ile neden-sonuç ilişkisini birbirine karıştırıyor olabilir miyiz?',
  ],
};
const dusunmeSorulari = DUSUNME_SORULARI[v.tip] ?? [
  'Bu anlatının temel nedeni ile görünen sonucu arasındaki bağ ne?',
  'Hangi kanıt veya bakış açısı bu yorumu değiştirebilir?',
];
const oturumSorulari = rotaAdimi
  ? [rotaAdimi.soru, ...dusunmeSorulari.filter((soru) => soru !== rotaAdimi.soru)].slice(0, 2)
  : dusunmeSorulari;
---
<Temel baslik={v.baslik} ozet={v.ozet} sayfaTuru="article">
  <div class="okuma-ilerleme" aria-hidden="true"><i data-okuma-ilerleme></i></div>
  <div class="sayfa">
    <main class="govde" id="ana" data-pagefind-body
          data-makale-id={v.id}
          data-rota-slug={rotaBaglami?.slug ?? ''}
          data-pagefind-filter={`tip:${tipAdi(v.tip)}`}
          data-pagefind-meta={`ozet:${v.ozet}`}>
      <p class="veri-etiket" style="margin-bottom:.6rem">
        {tipAdi(v.tip)}
        {v.donem && <> · Dönem {v.donem}</>}
      </p>
      <h1>{v.baslik}</h1>
      <p class="ozet">{v.ozet}</p>

      <div class="makale-araclari" data-pagefind-ignore>
        <dl>
          <div><dt>Okuma</dt><dd>≈ {okumaDakikasi} dakika</dd></div>
          <div><dt>Kaynak</dt><dd>{v.kaynaklar.length} künye</dd></div>
          <div><dt>Güven</dt><dd>{GUVEN_ADLARI[v.guven_geneli]}</dd></div>
        </dl>
        <a class="makale-bitir-kisayol" href="#ogrenme-kapanisi">
          Öğrenme oturumunu tamamla <span aria-hidden="true">↓</span>
        </a>
      </div>

      {rotalar.length > 0 && (
        <aside class="makale-rotalari" data-pagefind-ignore>
          <span class="veri-etiket">Bu yazı bir düşünme yolunun parçası</span>
          <div>
            {rotalar.map((rota) => {
              const adim = rota.adimlar.find((x) => x.id === v.id);
              return (
              <a href={bag(`/rotalar/${rota.slug}/`)}>
                <small>Rota {rota.no}{adim ? ` · ${adim.rol}` : ''}</small>
                <strong>{rota.baslik}</strong>
                <span aria-hidden="true">→</span>
              </a>
              );
            })}
          </div>
          {rotaAdimi && <p class="makale-rotalari__soru"><strong>Bu okumada aradığın bağ:</strong> {rotaAdimi.soru}</p>}
        </aside>
      )}

      <section class="oturum-baslangici" data-pagefind-ignore data-oturum-baslangici>
        <div class="oturum-baslangici__no" aria-hidden="true">01</div>
        <div>
          <span class="veri-etiket" data-once-etiket>Okumadan önce · tahmin et</span>
          <h2 data-once-baslik>İlk cevabını görünür kıl.</h2>
          <p data-once-soru>{rotaAdimi?.soru ?? (v.tip === 'tartisma' ? v.soru : dusunmeSorulari[0])}</p>
          <label for="once-cevap" class="gizli-gorsel">Okumadan önceki cevabın</label>
          <textarea id="once-cevap" rows="3" data-once-cevap
                    placeholder="İki veya üç cümle yeter. Doğru olmak zorunda değil; değişimi görebilmek için ilk düşünceni kaydet."></textarea>
          <div class="oturum-baslangici__eylem">
            <button type="button" data-once-kaydet>Tahminimi sakla, okumaya geç</button>
            <span role="status" data-once-durum></span>
          </div>
        </div>
      </section>

      <aside class="dusunme-karti" data-pagefind-ignore>
        <span class="veri-etiket">02 · Okurken bağlantıyı izle</span>
        <ol>
          {oturumSorulari.map((soru) => <li>{soru}</li>)}
        </ol>
      </aside>

      {icindekilerGoster && (
        <nav class="icindekiler" aria-label="Bölümler">
          <details>
            <summary>İçindekiler ({bolumler.length} bölüm)</summary>
            <ol>
              {bolumler.map((h: { slug: string; text: string }) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}

      {v.tip === 'kaynak' && (
        <dl class="kunye">
          <div><dt>Yazar</dt><dd>{v.yazar}</dd></div>
          <div><dt>Eser</dt><dd>{v.eser_adi}</dd></div>
          <div><dt>Yayın</dt><dd>{v.yayin_yili}</dd></div>
          <div>
            <dt>Telif</dt>
            <dd>{v.telif_durumu === 'kamu-mali' ? 'Kamu malı' : 'Telifli — tam metin veya bölüm çevirisi üretilmez'}</dd>
          </div>
        </dl>
      )}

      {v.tip === 'kaynak' && (
        <blockquote class="tez">
          <span class="veri-etiket" style="display:block;margin-bottom:.35rem">Tezi</span>
          {v.tez_ozeti}
        </blockquote>
      )}

      {v.tip === 'tartisma' && (
        <div class="soru-blok">
          <span class="veri-etiket">Soru</span>
          <p class="soru">{v.soru}</p>
          <span class="veri-etiket">Neden önemli</span>
          <p class="neden">{v.neden_onemli}</p>
        </div>
      )}

      <div class="makale-icerigi" data-makale-metni>
        {v.tip === 'veri' && <VeriGrafigi veri={v} />}

        <Content />

        {v.tip === 'tartisma' && <Pozisyonlar pozisyonlar={v.pozisyonlar} />}

        {v.tip === 'donem' && hat.length > 0 && <OkumaHatti hat={hat} donemNo={String(v.donem)} />}

        {v.tip === 'donem' && donemler.length > 0 && (
          <ZamanSeridi donemler={donemler} aktif={v.id} baslik="Bu dönemde, yedi bölgede" />
        )}

        <section class="ogrenme-kapanisi" id="ogrenme-kapanisi" data-pagefind-ignore>
          <header>
            <div class="ogrenme-kapanisi__no" aria-hidden="true">03</div>
            <div>
              <span class="veri-etiket">Metne bakmadan geri çağır</span>
              <h2>Şimdi bilgiyi kendi zihninden yeniden kur.</h2>
              <p>Hatırlayamadığın yer başarısızlık değil; bir sonraki tekrarın başlangıç noktasıdır.</p>
            </div>
          </header>

          <div class="kapanis-alani">
            <label for="sonra-cevap">
              <strong>Bu yazının ana fikrini bir arkadaşına nasıl açıklardın?</strong>
              <small>En az 30 karakterle bir olgu ve bir neden-sonuç bağı kur.</small>
            </label>
            <textarea id="sonra-cevap" rows="4" data-sonra-cevap
                      placeholder="Kaynağa dönmeden, kendi cümlelerinle…"></textarea>
          </div>

          <div class="kapanis-alani">
            <label for="kanit-notu">
              <strong>Hangi kanıt veya karşı görüş düşünceni değiştirdi?</strong>
              <small>En az 10 karakterle bir sayı, belge, karşılaştırma ya da itiraz seç.</small>
            </label>
            <textarea id="kanit-notu" rows="2" data-kanit-notu
                      placeholder="Bende iz bırakan kanıt…"></textarea>
          </div>

          <fieldset class="guven-secimi">
            <legend>Yarın bunu metne bakmadan anlatabileceğine ne kadar güveniyorsun?</legend>
            <label><input type="radio" name="ogrenme-guveni" value="1" /> <span>Zayıf</span><small>Yarın tekrar göster</small></label>
            <label><input type="radio" name="ogrenme-guveni" value="2" checked /> <span>Orta</span><small>Biraz zorlanırım</small></label>
            <label><input type="radio" name="ogrenme-guveni" value="3" /> <span>Güçlü</span><small>Kendi örneğimi kurabilirim</small></label>
          </fieldset>

          <details class="ilk-cevap" data-ilk-cevap hidden>
            <summary>İlk tahmininle şimdiki cevabını karşılaştır</summary>
            <blockquote data-ilk-cevap-metni></blockquote>
          </details>

          <div class="kapanis-eylem">
            <button type="button" data-oturum-tamamla disabled>
              Oturumu tamamla ve tekrarı planla <span aria-hidden="true">→</span>
            </button>
            <p role="status" data-tamamlama-durumu>Önce ana fikri ve sende iz bırakan kanıtı kendi cümlenle yaz.</p>
          </div>

          <div class="tekrar-degerlendirme" data-tekrar-degerlendirme hidden>
            <p><strong>Metinle karşılaştırınca hatırlaman nasıldı?</strong></p>
            <div>
              <button type="button" data-tekrar-sonuc="zor">Zorlandım</button>
              <button type="button" data-tekrar-sonuc="orta">Hatırladım</button>
              <button type="button" data-tekrar-sonuc="kolay">Kolaydı</button>
            </div>
          </div>

          <div class="oturum-sonrasi" data-oturum-sonrasi hidden>
            <div>
              <span class="veri-etiket">Döngü tamamlandı</span>
              <strong>Bugün bir bağlantıyı gerçekten işledin.</strong>
              <small>Yarın yeniden okumadan önce hatırlamayı deneyeceksin.</small>
            </div>
            <div>
              <a href={bag('/bugun/')}>Bugünkü oturumu kapat</a>
              {rotaBaglami && (
                <a class="oturum-sonrasi__ileri" href={sonrakiRotaMakalesi
                  ? `${yol(sonrakiRotaAdimi!.id)}?rota=${rotaBaglami.slug}`
                  : `${bag(`/rotalar/${rotaBaglami.slug}/`)}#rota-sentezi`}>
                  {sonrakiRotaMakalesi ? `Sıradaki: ${sonrakiRotaMakalesi.data.baslik}` : 'Rotanın sentezini yap'} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </section>

        <KaynakListesi kaynaklar={v.kaynaklar} />

        <p class="beyan" data-pagefind-ignore>
        Bu makale otonom olarak üretildi ve otonom olarak denetlendi
        (son denetim: {v.son_denetim}, {v.kaynaklar.length} kaynak,
        güven seviyesi: {GUVEN_ADLARI[v.guven_geneli].toLocaleLowerCase('tr')}).
        {hakem ? (
          <span>
            {' '}Bu dosya ayrıca <strong>kör hakemden geçti</strong>: makaleyi yazmamış
            bir oturum {hakem.iddia} iddianın kaynağını tek tek sınadı ({hakem.zaman}) ve
            {' '}{hakem.dogrudan} tanesini kaynağın doğrudan taşıdığı,
            {' '}{hakem.kismi} tanesini kısmen taşıdığı olarak kaydetti.
          </span>
        ) : (
          <span>
            {' '}Bu dosya <strong>henüz kör hakemden geçmedi</strong>; denetimi mekanik
            katmanın gördüğü kadarıyla sınırlıdır.
          </span>
        )}
        Ölçülen doğrulama oranı ve bilinen sınırlar için <a href={bag("/hakkinda/")}>Hakkında</a>.
        </p>

        {v.kaynak_siniri && (
          <p class="beyan beyan--sinir" data-pagefind-ignore>
            <strong>Bu dosyanın kaynak sınırı.</strong> {v.kaynak_siniri}
          </p>
        )}

        {komsu && (
          <SiraSeridi onceki={komsu.onceki} sonraki={komsu.sonraki}
                      sira={komsu.sira} toplam={komsu.toplam} donemNo={komsu.donemNo} />
        )}
      </div>
    </main>
    <AygitRayi veri={v} ilgili={ilgili} okuma={okuma} />
  </div>
</Temel>

<style>
  .ozet {
    font-size: 1.16rem; line-height: 1.6; color: var(--golge);
    margin: 0 0 2rem; padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--cizgi-ince);
    text-wrap: pretty;
  }
  .okuma-ilerleme { position: fixed; z-index: 40; left: 0; right: 0; top: 0; height: 3px; pointer-events: none; }
  .okuma-ilerleme i { display: block; width: 0; height: 100%; background: var(--bakir); }
  .makale-araclari { display: flex; justify-content: space-between; gap: 1.2rem; align-items: center; margin: -1rem 0 2rem; padding: .8rem 0; border-bottom: 1px solid var(--cizgi-ince); }
  .makale-araclari dl { display: flex; flex-wrap: wrap; gap: 1rem 1.8rem; margin: 0; }
  .makale-araclari dl div { display: grid; }
  .makale-araclari dt { font-family: var(--f-veri); font-size: .58rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--golge); }
  .makale-araclari dd { margin: .12rem 0 0; font-family: var(--f-veri); font-size: .75rem; }
  .makale-bitir-kisayol { display: inline-flex; gap: .6rem; align-items: center; flex: 0 0 auto; border: 1px solid var(--cizgi); color: var(--murekkep); padding: .55rem .7rem; font-family: var(--f-veri); font-size: .68rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; text-decoration: none; }
  .makale-rotalari { margin: 0 0 2rem; padding: 1rem 1.1rem; border-left: 2px solid var(--bakir); background: var(--yuzey); }
  .makale-rotalari > div { display: grid; gap: .45rem; margin-top: .65rem; }
  .makale-rotalari a { display: grid; grid-template-columns: 1fr auto; color: inherit; text-decoration: none; padding-top: .5rem; border-top: 1px solid var(--cizgi-ince); }
  .makale-rotalari a small { grid-column: 1; font-family: var(--f-veri); font-size: .6rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--bakir); }
  .makale-rotalari a strong { grid-column: 1; font-family: var(--f-display); }
  .makale-rotalari a > span { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--bakir); }
  .makale-rotalari__soru { margin: .8rem 0 0; padding-top: .75rem; border-top: 1px solid var(--cizgi-ince); color: var(--golge); font-size: .84rem; line-height: 1.5; }
  .makale-rotalari__soru strong { color: var(--murekkep); }
  .dusunme-karti { margin: 0 0 2rem; padding: 1rem 1.1rem 1.1rem; border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); background: color-mix(in srgb, var(--yuzey) 72%, transparent); }
  .dusunme-karti ol { margin: .7rem 0 0; padding: 0; list-style: none; counter-reset: dusunme; display: grid; gap: .55rem; }
  .dusunme-karti li { counter-increment: dusunme; position: relative; padding-left: 1.8rem; line-height: 1.5; font-family: var(--f-display); font-size: .98rem; }
  .dusunme-karti li::before { content: counter(dusunme, decimal-leading-zero); position: absolute; left: 0; top: .16rem; color: var(--bakir); font-family: var(--f-veri); font-size: .6rem; font-weight: 700; letter-spacing: .06em; }
  .oturum-baslangici { display: grid; grid-template-columns: 2.8rem 1fr; gap: 1rem; margin: 0 0 1.5rem; padding: 1.2rem; border: 1px solid var(--cizgi); border-top: 3px solid var(--bakir); background: var(--bakir-zemin); }
  .oturum-baslangici__no, .ogrenme-kapanisi__no { font-family: var(--f-display); font-size: 1.7rem; line-height: 1; color: var(--bakir); }
  .oturum-baslangici h2 { font-size: 1.35rem; margin: .25rem 0 .4rem; }
  .oturum-baslangici p { color: var(--golge); font-size: .92rem; }
  .oturum-baslangici textarea, .kapanis-alani textarea { width: 100%; resize: vertical; border: 1px solid var(--cizgi); background: var(--yuzey); color: var(--murekkep); padding: .75rem; font: .92rem/1.55 var(--f-govde); }
  .oturum-baslangici__eylem { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-top: .65rem; }
  .oturum-baslangici__eylem button, .kapanis-eylem button { border: 0; background: var(--murekkep); color: var(--tabaka); padding: .65rem .85rem; font-family: var(--f-veri); font-size: .7rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; }
  .oturum-baslangici__eylem span { color: var(--bakir); font-family: var(--f-veri); font-size: .7rem; }
  .makale-icerigi[data-tekrar-kilitli] { display: none; }
  .ogrenme-kapanisi { scroll-margin-top: 6rem; margin: 3.5rem 0; padding: 1.35rem; border: 1px solid var(--cizgi); border-top: 4px solid var(--zincifre); background: var(--yuzey); }
  .ogrenme-kapanisi header { display: grid; grid-template-columns: 2.8rem 1fr; gap: 1rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--cizgi); }
  .ogrenme-kapanisi__no { color: var(--zincifre); }
  .ogrenme-kapanisi h2 { margin: .25rem 0 .45rem; font-size: 1.55rem; }
  .ogrenme-kapanisi header p { color: var(--golge); font-size: .9rem; }
  .kapanis-alani { display: grid; gap: .55rem; padding: 1.2rem 0; border-bottom: 1px solid var(--cizgi-ince); }
  .kapanis-alani label { display: grid; }
  .kapanis-alani label strong { font-family: var(--f-display); font-size: 1rem; }
  .kapanis-alani label small { color: var(--golge); }
  .guven-secimi { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 1.2rem 0; padding: 0; border: 1px solid var(--cizgi); }
  .guven-secimi legend { width: 100%; margin-bottom: .7rem; font-family: var(--f-display); font-weight: 600; }
  .guven-secimi label { position: relative; display: grid; padding: .8rem .8rem .8rem 2.2rem; cursor: pointer; }
  .guven-secimi label + label { border-left: 1px solid var(--cizgi); }
  .guven-secimi input { position: absolute; left: .7rem; top: 1rem; accent-color: var(--bakir); }
  .guven-secimi label:has(input:checked) { background: var(--bakir-zemin); }
  .guven-secimi span { font-family: var(--f-veri); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  .guven-secimi small { color: var(--golge); font-size: .72rem; }
  .ilk-cevap { margin: 1rem 0; padding: .8rem; border: 1px solid var(--cizgi-ince); }
  .ilk-cevap summary { cursor: pointer; font-family: var(--f-veri); font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .ilk-cevap blockquote { margin-bottom: 0; }
  .kapanis-eylem { display: flex; align-items: center; gap: 1rem; padding-top: 1rem; }
  .kapanis-eylem button:disabled { opacity: .45; cursor: not-allowed; }
  .kapanis-eylem p { color: var(--golge); font-size: .78rem; }
  .tekrar-degerlendirme { margin-top: 1rem; padding: 1rem; background: var(--oksit-zemin); border-left: 3px solid var(--oksit); }
  .tekrar-degerlendirme > div { display: flex; flex-wrap: wrap; gap: .5rem; }
  .tekrar-degerlendirme button { border: 1px solid var(--oksit); background: transparent; color: var(--murekkep); padding: .5rem .7rem; font-family: var(--f-veri); cursor: pointer; }
  .oturum-sonrasi { display: grid; grid-template-columns: 1fr auto; gap: 1.2rem; align-items: end; margin-top: 1rem; padding: 1rem; background: var(--bakir-zemin); border: 1px solid var(--bakir); }
  .oturum-sonrasi[hidden] { display: none; }
  .oturum-sonrasi > div { display: grid; gap: .25rem; }
  .oturum-sonrasi strong { font-family: var(--f-display); font-size: 1.15rem; }
  .oturum-sonrasi small { color: var(--golge); }
  .oturum-sonrasi > div:last-child { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem; }
  .oturum-sonrasi a { padding: .55rem .7rem; border: 1px solid var(--cizgi); color: inherit; font-family: var(--f-veri); font-size: .68rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; text-decoration: none; }
  .oturum-sonrasi .oturum-sonrasi__ileri { background: var(--murekkep); border-color: var(--murekkep); color: var(--tabaka); }
  .kunye { display: grid; gap: 0; margin: 0 0 1.75rem; border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); overflow: hidden; }
  .kunye > div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: .6rem .9rem; background: var(--yuzey); }
  .kunye > div + div { border-top: 1px solid var(--cizgi-ince); }
  .kunye dt { font-family: var(--f-veri); font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--golge); padding-top: .2rem; }
  .kunye dd { margin: 0; font-size: .95rem; }
  .tez { margin: 0 0 2rem !important; padding: 1rem 1.15rem !important; background: var(--yuzey); border-inline-start: 2px solid var(--bakir) !important; border-radius: 0 var(--yuvarlak-buyuk) var(--yuvarlak-buyuk) 0; font-style: normal !important; color: var(--murekkep) !important; }
  .soru-blok { margin: 0 0 2.25rem; padding: 1.15rem 1.25rem; background: var(--yuzey); border: 1px solid var(--cizgi-ince); border-radius: var(--yuvarlak-buyuk); }
  .soru { font-family: var(--f-display); font-variation-settings: 'opsz' 28, 'SOFT' 0, 'WONK' 0; font-size: 1.24rem; line-height: 1.35; margin: .3rem 0 1.1rem; }
  .neden { margin: .3rem 0 0; font-size: .95rem; color: var(--golge); }
  .beyan--sinir { border-left: 3px solid var(--zincifre); padding-left: .9rem; }
  .beyan { margin-top: 2.5rem; padding-top: 1.1rem; border-top: 1px solid var(--cizgi-ince); font-size: .84rem; line-height: 1.6; color: var(--golge); }
  @media (max-width: 620px) {
    .makale-araclari { align-items: stretch; flex-direction: column; }
    .makale-bitir-kisayol { align-self: flex-start; }
    .guven-secimi { grid-template-columns: 1fr; }
    .guven-secimi label + label { border-left: 0; border-top: 1px solid var(--cizgi); }
    .kapanis-eylem { align-items: stretch; flex-direction: column; }
    .oturum-sonrasi { grid-template-columns: 1fr; }
    .oturum-sonrasi > div:last-child { justify-content: flex-start; }
  }
</style>

<script>
  import {
    durumOku, durumYaz, makaleBaslat, makaleAlaniKaydet, ilerlemeKaydet,
    makaleTamamla, tekrarDegerlendir,
  } from '../../lib/ogrenme-durumu.mjs';

  const makale = document.querySelector<HTMLElement>('[data-makale-id]');
  const id = makale?.dataset.makaleId || '';
  const rotaSlug = makale?.dataset.rotaSlug || '';
  let durum: any = makaleBaslat(durumOku(), id);
  durum = durumYaz(durum);
  const kayit = durum.makaleler[id];
  const once = document.querySelector<HTMLTextAreaElement>('[data-once-cevap]');
  const sonra = document.querySelector<HTMLTextAreaElement>('[data-sonra-cevap]');
  const kanit = document.querySelector<HTMLTextAreaElement>('[data-kanit-notu]');
  if (once) once.value = kayit?.onceCevap || '';
  if (sonra) sonra.value = kayit?.sonraCevap || '';
  if (kanit) kanit.value = kayit?.kanitNotu || '';

  function alanKaydet(alan: string, deger: string) {
    durum = durumYaz(makaleAlaniKaydet(durum, id, alan, deger));
  }
  once?.addEventListener('change', () => alanKaydet('onceCevap', once.value));
  function tamamlamayiBoya() {
    const tamamla = document.querySelector<HTMLButtonElement>('[data-oturum-tamamla]');
    if (tamamla) tamamla.disabled = (sonra?.value.trim().length || 0) < 30
      || (kanit?.value.trim().length || 0) < 10;
  }
  sonra?.addEventListener('input', tamamlamayiBoya);
  sonra?.addEventListener('change', () => alanKaydet('sonraCevap', sonra.value));
  kanit?.addEventListener('change', () => alanKaydet('kanitNotu', kanit.value));
  kanit?.addEventListener('input', tamamlamayiBoya);

  const tekrarKipi = new URLSearchParams(location.search).get('tekrar') === '1';
  const istenenRota = new URLSearchParams(location.search).get('rota') || '';
  const rotaKipi = Boolean(rotaSlug && istenenRota === rotaSlug);
  const metin = document.querySelector<HTMLElement>('[data-makale-metni]');
  if ((tekrarKipi || (rotaKipi && !kayit?.onceCevap)) && metin) {
    metin.dataset.tekrarKilitli = '';
  }
  if (tekrarKipi) {
    const etiket = document.querySelector<HTMLElement>('[data-once-etiket]');
    const baslik = document.querySelector<HTMLElement>('[data-once-baslik]');
    const dugme = document.querySelector<HTMLButtonElement>('[data-once-kaydet]');
    if (etiket) etiket.textContent = 'Aralıklı tekrar · metne bakmadan';
    if (baslik) baslik.textContent = 'Önce hatırladığını yaz.';
    if (dugme) dugme.textContent = 'Cevabımı yazdım, metinle karşılaştır';
  }

  function onceCevabiBoya() {
    const dugme = document.querySelector<HTMLButtonElement>('[data-once-kaydet]');
    if (dugme) dugme.disabled = (tekrarKipi || rotaKipi) && (once?.value.trim().length || 0) < 15;
  }
  once?.addEventListener('input', onceCevabiBoya);

  document.querySelector<HTMLButtonElement>('[data-once-kaydet]')?.addEventListener('click', () => {
    if ((tekrarKipi || rotaKipi) && (once?.value.trim().length || 0) < 15) {
      const bildirim = document.querySelector<HTMLElement>('[data-once-durum]');
      if (bildirim) bildirim.textContent = 'Önce en az 15 karakterle kendi tahminini yaz.';
      return;
    }
    alanKaydet('onceCevap', once?.value || '');
    const bildirim = document.querySelector<HTMLElement>('[data-once-durum]');
    if (bildirim) bildirim.textContent = tekrarKipi ? 'Şimdi metinle karşılaştır.' : 'İlk cevabın saklandı.';
    if ((tekrarKipi || rotaKipi) && metin) delete metin.dataset.tekrarKilitli;
    ((tekrarKipi || rotaKipi) ? metin : document.querySelector('.dusunme-karti'))?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  const ilkCevap = document.querySelector<HTMLDetailsElement>('[data-ilk-cevap]');
  const ilkCevapMetni = document.querySelector<HTMLElement>('[data-ilk-cevap-metni]');
  if (kayit?.onceCevap && ilkCevap && ilkCevapMetni) {
    ilkCevap.hidden = false;
    ilkCevapMetni.textContent = kayit.onceCevap;
  }

  document.querySelector<HTMLButtonElement>('[data-oturum-tamamla]')?.addEventListener('click', () => {
    const cevap = sonra?.value.trim() || '';
    if (cevap.length < 30 || (kanit?.value.trim().length || 0) < 10) return;
    alanKaydet('sonraCevap', cevap);
    alanKaydet('kanitNotu', kanit?.value || '');
    const secili = document.querySelector<HTMLInputElement>('input[name="ogrenme-guveni"]:checked');
    durum = durumYaz(makaleTamamla(durum, id, { guven: Number(secili?.value || 2) }));
    const bildirim = document.querySelector<HTMLElement>('[data-tamamlama-durumu]');
    if (bildirim) bildirim.textContent = 'Oturum tamamlandı. Bu fikir yarın geri çağırma kuyruğuna gelecek.';
    const karsilastir = document.querySelector<HTMLDetailsElement>('[data-ilk-cevap]');
    const karsilastirMetni = document.querySelector<HTMLElement>('[data-ilk-cevap-metni]');
    if (durum.makaleler[id].onceCevap && karsilastir && karsilastirMetni) {
      karsilastir.hidden = false;
      karsilastir.open = true;
      karsilastirMetni.textContent = durum.makaleler[id].onceCevap;
    }
    const tekrar = document.querySelector<HTMLElement>('[data-tekrar-degerlendirme]');
    if (tekrarKipi && tekrar) tekrar.hidden = false;
    const sonrasi = document.querySelector<HTMLElement>('[data-oturum-sonrasi]');
    if (sonrasi) sonrasi.hidden = false;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-tekrar-sonuc]').forEach((dugme) => {
    dugme.addEventListener('click', () => {
      durum = durumYaz(tekrarDegerlendir(durum, id, dugme.dataset.tekrarSonuc || 'orta'));
      const gun = Math.max(1, Math.round((new Date(durum.makaleler[id].sonrakiTekrar).getTime() - Date.now()) / 86_400_000));
      const bildirim = document.querySelector<HTMLElement>('[data-tamamlama-durumu]');
      if (bildirim) bildirim.textContent = `Hatırlama değerlendirildi. Sonraki karşılaşma yaklaşık ${gun} gün sonra.`;
      document.querySelector<HTMLElement>('[data-tekrar-degerlendirme]')?.setAttribute('hidden', '');
    });
  });

  if (kayit?.tamamlandi) {
    const sonrasi = document.querySelector<HTMLElement>('[data-oturum-sonrasi]');
    if (sonrasi) sonrasi.hidden = false;
  }
  onceCevabiBoya();
  tamamlamayiBoya();

  const cubuk = document.querySelector<HTMLElement>('[data-okuma-ilerleme]');
  function ilerlemeyiBoya() {
    if (!cubuk || !makale) return;
    const bas = makale.getBoundingClientRect().top + scrollY;
    const son = bas + makale.offsetHeight - innerHeight;
    const oran = son <= bas ? 1 : Math.max(0, Math.min(1, (scrollY - bas) / (son - bas)));
    cubuk.style.width = `${oran * 100}%`;
    if (id && Math.round(oran * 10) > Math.round((durum.makaleler[id]?.ilerleme || 0) * 10)) {
      durum = durumYaz(ilerlemeKaydet(durum, id, oran));
    }
  }
  addEventListener('scroll', ilerlemeyiBoya, { passive: true });
  addEventListener('resize', ilerlemeyiBoya);
  ilerlemeyiBoya();
</script>
